# ── Razorpay Keys ──────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ── PayPal Keys ────────────────────────────────────────
# Get from: https://developer.paypal.com/dashboard/applications
# Mode: sandbox (for testing) | live (for production)
PAYPAL_CLIENT_ID=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=EKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_MODE=sandbox

# ── Server ─────────────────────────────────────────────
PORT=3000

# ── Frontend URL (for CORS) ────────────────────────────
# In production, replace * with your actual site URL
FRONTEND_URL=*
